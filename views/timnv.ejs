<%- include('header') %>

<h1 class="mt-4">Tìm kiếm nhân viên</h1>

<form action="/" method="GET" class="mt-3" style="max-width: 500px;">
    <div class="mb-3">
        <label class="form-label">Tên nhân viên</label>
        <input type="text" name="txtTen" class="form-control" placeholder="Nhập tên nhân viên">
    </div>

    <div class="mb-3">
        <label class="form-label">Tuổi từ</label>
        <input type="number" name="tuoiTu" class="form-control" min="0" placeholder="Ví dụ: 20">
    </div>

    <div class="mb-3">
        <label class="form-label">Tuổi đến</label>
        <input type="number" name="tuoiDen" class="form-control" min="0" placeholder="Ví dụ: 30">
    </div>

    <button type="submit" class="btn btn-primary">Tìm nhân viên</button>
    <a href="/" class="btn btn-secondary">Xem tất cả</a>
</form>

<%- include('footer') %>